<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="telaSFML" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="win_debug">
				<Option output="bin/Win_Debug/telaSFML" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Win_Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="dependencias/windows/SFML-2.4.2/include" />
				</Compiler>
				<Linker>
					<Add library="sfml-graphics-d" />
					<Add library="sfml-window-d" />
					<Add library="sfml-system-d" />
					<Add directory="dependencias/windows/SFML-2.4.2/lib" />
				</Linker>
			</Target>
			<Target title="win_release">
				<Option output="bin/Win_Release/telaSFML" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Win_Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="dependencias/windows/SFML-2.4.2/include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="sfml-graphics" />
					<Add library="sfml-window" />
					<Add library="sfml-system" />
					<Add directory="dependencias/windows/SFML-2.4.2/lib" />
				</Linker>
			</Target>
			<Target title="lin_debug">
				<Option output="bin/Lin_Debug/telaSFML" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Lin_Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="dependencias/linux/SFML-2.4.2/include" />
				</Compiler>
				<Linker>
					<Add option="-Wl,-rpath,&apos;$ORIGIN/dependencias/linux/SFML-2.4.2/lib&apos;" />
					<Add library="sfml-graphics" />
					<Add library="sfml-window" />
					<Add library="sfml-system" />
					<Add library="stb" />
					<Add directory="dependencias/linux/SFML-2.4.2/lib" />
				</Linker>
			</Target>
			<Target title="lin_release">
				<Option output="bin/Lin_Release/telaSFML" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Lin_Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="dependencias/linux/SFML-2.4.2/include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-Wl,-rpath,&apos;$ORIGIN/dependencias/linux/SFML-2.4.2/lib&apos;" />
					<Add library="sfml-graphics" />
					<Add library="sfml-window" />
					<Add library="sfml-system" />
					<Add library="stb" />
					<Add directory="dependencias/linux/SFML-2.4.2/lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
